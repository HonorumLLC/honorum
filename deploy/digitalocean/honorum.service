[Unit]
Description=Honorum production API, worker and private tunnel
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/honorum/current
ExecStart=/usr/bin/docker compose --env-file /etc/honorum/release.env up -d --wait --wait-timeout 180
ExecStop=/usr/bin/docker compose --env-file /etc/honorum/release.env stop
TimeoutStartSec=240
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
